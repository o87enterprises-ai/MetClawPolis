\f4\fs26 \cf0 export class ConflictResolution \{\
  constructor(scene, stats) \{\
    this.scene = scene;\
    this.stats = stats;\
  \}\
\
  open(caseData) \{\
    const panel = this.scene.add.rectangle(60, 40, 240, 120, 0x000000, 0.7).setOrigin(0);\
    const text = this.scene.add.text(70, 50, `Case: $\{caseData.issue\}`, \{ fontSize: "9px", color: "#fff", wordWrap: \{ width: 220 \} \});\
\
    let offsetY = 70;\
    caseData.options.forEach(opt => \{\
      this.scene.add.text(70, offsetY, `[$\{opt\}]`, \{ fontSize: "8px", color: "#0f0" \})\
        .setInteractive()\
        .on("pointerdown", () => \{\
          const fair = opt === caseData.recommended;\
          if (fair) this.stats.modifyReputation("law", 2);\
          else this.stats.modifyReputation("law", -1);\
\
          this.scene.events.emit("world_event", \{\
            type: "conflict_resolved",\
            caseId: caseData.id,\
            choice: opt,\
            fair\
          \});\
\
          panel.destroy();\
          text.destroy();\
        \});\
      offsetY += 15;\
    \});\
\
    this.panel = panel;\
    this.text = text;\
  \}\
\}\
