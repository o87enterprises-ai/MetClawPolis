\f4\fs26 \cf0 export class InteriorManager \{\
  constructor(scene) \{\
    this.scene = scene;\
    this.active = null;\
  \}\
\
  enter(buildingId) \{\
    if (this.active) return;\
\
    this.scene.cameras.main.fadeOut(200, 0, 0, 0);\
\
    this.scene.time.delayedCall(200, () => \{\
      this.scene.worldContainer.setVisible(false);\
\
      this.interior = this.scene.make.tilemap(\{\
        key: `interior_$\{buildingId\}`,\
        tileWidth: 16,\
        tileHeight: 16\
      \});\
\
      const tiles = this.interior.addTilesetImage('interiors');\
      this.layer = this.interior.createLayer('Main', tiles);\
\
      this.scene.cameras.main.fadeIn(200);\
      this.active = buildingId;\
    \});\
  \}\
\
  exit() \{\
    if (!this.active) return;\
\
    this.scene.cameras.main.fadeOut(200);\
\
    this.scene.time.delayedCall(200, () => \{\
      this.layer.destroy();\
      this.scene.worldContainer.setVisible(true);\
      this.scene.cameras.main.fadeIn(200);\
      this.active = null;\
    \});\
  \}\
\}\
