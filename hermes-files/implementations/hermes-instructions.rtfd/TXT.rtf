\fs24 \cf0 DialogueBubble helper:
\f1\b0 \
\pard\pardeftab720\partightenfactor0
\cf0 js\
\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 class DialogueBubble \{\
  constructor(scene, targetSprite, textLines, duration = 3000) \{\
    this.scene = scene;\
    this.target = targetSprite;\
\
    const style = \{ fontSize: '8px', color: '#000000', wordWrap: \{ width: 80 \} \};\
    this.text = scene.add.text(0, 0, textLines.join('\\n'), style);\
    this.bg = scene.add.rectangle(0, 0, this.text.width + 6, this.text.height + 4, 0xffffff, 0.9);\
\
    this.bg.setOrigin(0.5);\
    this.text.setOrigin(0.5);\
\
    this.bg.setDepth(1000);\
    this.text.setDepth(1001);\
\
    this.updatePosition();\
\
    this.timer = scene.time.addEvent(\{\
      delay: duration,\
      callback: () => this.destroy()\
    \});\
\
    scene.events.on('update', this.updatePosition, this);\
  \}\
\
  updatePosition() \{\
    const x = this.target.x;\
    const y = this.target.y - 18;\
    this.bg.setPosition(x, y);\
    this.text.setPosition(x, y);\
  \}\
\
  destroy() \{\
    this.bg.destroy();\
    this.text.destroy();\
    this.scene.events.off('update', this.updatePosition, this);\
  \}\
\}\
\pard\pardeftab720\sa240\partightenfactor0

