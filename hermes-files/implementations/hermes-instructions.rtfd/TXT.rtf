\f4\fs26 \cf0 export class PlayerStats \{\
  constructor(scene, config) \{\
    this.scene = scene;\
    this.energy = config.max_energy;\
    this.stress = 0;\
    this.xp = 0;\
    this.level = 1;\
    this.skills = \{\};\
    config.skills.forEach(s => this.skills[s] = 0);\
    this.reputation = \{\};\
    config.reputation_zones.forEach(z => this.reputation[z] = 0);\
    this.config = config;\
  \}\
\
  addXP(amount) \{\
    this.xp += amount;\
    const curve = this.config.xp_curve;\
    while (this.level < curve.length && this.xp >= curve[this.level]) \{\
      this.level++;\
      this.scene.events.emit("world_event", \{\
        type: "level_up",\
        level: this.level\
      \});\
    \}\
  \}\
\
  modifyEnergy(amount) \{\
    this.energy = Phaser.Math.Clamp(this.energy + amount, 0, this.config.max_energy);\
  \}\
\
  modifyStress(amount) \{\
    this.stress = Phaser.Math.Clamp(this.stress + amount, 0, this.config.max_stress);\
  \}\
\
  modifyReputation(zone, amount) \{\
    this.reputation[zone] += amount;\
  \}\
\}\
