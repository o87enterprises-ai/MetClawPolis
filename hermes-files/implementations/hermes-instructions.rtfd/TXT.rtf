\f4\fs26 \cf0 export class MonitorPost \{\
  constructor(scene, npc, patrolPoints) \{\
    this.scene = scene;\
    this.npc = npc;\
    this.points = patrolPoints;\
    this.index = 0;\
    this.speed = 40;\
\
    scene.time.addEvent(\{\
      delay: 100,\
      loop: true,\
      callback: () => this.update()\
    \});\
  \}\
\
  update() \{\
    const target = this.points[this.index];\
    const dx = target.x - this.npc.base.x;\
    const dy = target.y - this.npc.base.y;\
\
    if (Math.abs(dx) < 2 && Math.abs(dy) < 2) \{\
      this.index = (this.index + 1) % this.points.length;\
      return;\
    \}\
\
    const angle = Math.atan2(dy, dx);\
    this.npc.base.x += Math.cos(angle) * this.speed * 0.016;\
    this.npc.base.y += Math.sin(angle) * this.speed * 0.016;\
\
    // Rule enforcement example\
    if (this.detectViolation()) \{\
      this.scene.events.emit('world_event', \{\
        type: 'violation',\
        npcId: this.npc.id,\
        message: "Rule violation detected"\
      \});\
    \}\
  \}\
\
  detectViolation() \{\
    // Placeholder logic\
    return false;\
  \}\
\}\
