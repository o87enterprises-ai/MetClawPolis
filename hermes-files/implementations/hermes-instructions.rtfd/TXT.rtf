\f4\fs26 \cf0 export function createBitsburgWorld(scene) \{\
  const world = scene.cache.json.get('bitsburg_world');\
  const tileSize = world.tile_size[0];\
\
  const map = scene.make.tilemap(\{\
    width: world.size[0],\
    height: world.size[1],\
    tileWidth: tileSize,\
    tileHeight: tileSize\
  \});\
\
  const ground = map.addTilesetImage('ground');\
  const roads = map.addTilesetImage('roads');\
  const water = map.addTilesetImage('water');\
  const buildings = map.addTilesetImage('buildings');\
  const decor = map.addTilesetImage('decor');\
\
  const groundLayer = map.createBlankLayer('Ground', ground);\
  const roadLayer = map.createBlankLayer('Roads', roads);\
  const waterLayer = map.createBlankLayer('Water', water);\
  const buildingLayer = map.createBlankLayer('Buildings', buildings);\
  const decorLayer = map.createBlankLayer('Decor', decor);\
\
  const layerMap = \{\
    "G": groundLayer,\
    "R": roadLayer,\
    "W": waterLayer,\
    "B": buildingLayer,\
    "P": decorLayer\
  \};\
\
  Object.entries(world.layers).forEach(([layerName, rowString]) => \{\
    rowString.split('').forEach((char, x) => \{\
      const layer = layerMap[char];\
      if (layer) layer.putTileAt(1, x, 0);\
    \});\
  \});\
\
  // Place buildings\
  world.buildings.forEach(b => \{\
    const [x1, y1, x2, y2] = b.coords;\
    for (let x = x1; x <= x2; x++) \{\
      for (let y = y1; y <= y2; y++) \{\
        buildingLayer.putTileAt(1, x, y);\
      \}\
    \}\
  \});\
\
  return \{ map, layers: \{ groundLayer, roadLayer, waterLayer, buildingLayer, decorLayer \} \};\
\}\
