\f4\fs26 \cf0 export class CertificationManager \{\
  constructor(scene, stats, skillsConfig) \{\
    this.scene = scene;\
    this.stats = stats;\
    this.config = skillsConfig;\
  \}\
\
  open(certId) \{\
    const cert = this.config.certifications.find(c => c.id === certId);\
    if (!cert) return;\
\
    const currentSkillXP = this.stats.skills[cert.skill] || 0;\
    const requiredXP = cert.required_level * this.config.skills[cert.skill].xp_per_level;\
\
    const panel = this.scene.add.rectangle(80, 40, 220, 110, 0x000000, 0.7).setOrigin(0);\
    const text = this.scene.add.text(90, 50, `Certification: $\{cert.title\}`, \{ fontSize: "10px", color: "#fff" \});\
\
    const status = this.scene.add.text(90, 65, `Skill XP: $\{currentSkillXP\}/$\{requiredXP\}`, \{ fontSize: "8px", color: "#fff" \});\
\
    const btn = this.scene.add.text(90, 85, "[Take Test]", \{ fontSize: "8px", color: "#0f0" \})\
      .setInteractive()\
      .on("pointerdown", () => \{\
        if (currentSkillXP < requiredXP) \{\
          status.setText("Not enough skill XP.");\
          return;\
        \}\
        this.stats.addXP(cert.reward_xp);\
        this.scene.events.emit("world_event", \{ type: "cert_awarded", certId: cert.id, title: cert.title \});\
        status.setText("Certified!");\
      \});\
\
    this.panel = panel;\
    this.text = text;\
    this.status = status;\
    this.btn = btn;\
  \}\
\
  close() \{\
    this.panel.destroy();\
    this.text.destroy();\
    this.status.destroy();\
    this.btn.destroy();\
  \}\
\}\
