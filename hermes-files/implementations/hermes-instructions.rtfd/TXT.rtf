\f3\b\fs24 \cf0 Simple inventory class (Phaser scene\uc0\u8209 local):
\f1\b0 \
\pard\pardeftab720\partightenfactor0
\cf0 js\
\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 class Inventory \{\
  constructor(scene, config) \{\
    this.scene = scene;\
    this.config = config;\
    this.items = []; // \{ id, qty \}\
  \}\
\
  addItem(id, qty = 1) \{\
    const item = this.items.find(i => i.id === id);\
    if (item && this.isStackable(id)) \{\
      item.qty += qty;\
    \} else \{\
      this.items.push(\{ id, qty \});\
    \}\
  \}\
\
  removeItem(id, qty = 1) \{\
    const item = this.items.find(i => i.id === id);\
    if (!item) return;\
    item.qty -= qty;\
    if (item.qty <= 0) \{\
      this.items = this.items.filter(i => i.id !== id);\
    \}\
  \}\
\
  isStackable(id) \{\
    const def = this.config.item_types.find(t => t.id === id);\
    return def ? !!def.stackable : true;\
  \}\
\}\
\pard\pardeftab720\sa240\partightenfactor0

