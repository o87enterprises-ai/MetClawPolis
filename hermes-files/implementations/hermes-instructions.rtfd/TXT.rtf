\f4\fs26 \cf0 export class EnforcementPatrol \{\
  constructor(scene, npc, patrolPoints, player, inventory, stats) \{\
    this.scene = scene;\
    this.npc = npc;\
    this.points = patrolPoints;\
    this.index = 0;\
    this.speed = 40;\
    this.player = player;\
    this.inventory = inventory;\
    this.stats = stats;\
\
    scene.time.addEvent(\{\
      delay: 100,\
      loop: true,\
      callback: () => this.update()\
    \});\
  \}\
\
  update() \{\
    const target = this.points[this.index];\
    const dx = target.x - this.npc.base.x;\
    const dy = target.y - this.npc.base.y;\
\
    if (Math.abs(dx) < 2 && Math.abs(dy) < 2) \{\
      this.index = (this.index + 1) % this.points.length;\
      return;\
    \}\
\
    const angle = Math.atan2(dy, dx);\
    this.npc.base.x += Math.cos(angle) * this.speed * 0.016;\
    this.npc.base.y += Math.sin(angle) * this.speed * 0.016;\
\
    this.checkPlayer();\
  \}\
\
  checkPlayer() \{\
    const dist = Phaser.Math.Distance.Between(\
      this.npc.base.x, this.npc.base.y,\
      this.player.x, this.player.y\
    );\
\
    if (dist < 40) \{\
      const zone = this.scene.currentZone || "unknown";\
      const violations = EnforcementRules.check(this.stats, zone, this.inventory);\
\
      if (violations.length > 0) \{\
        this.scene.events.emit("world_event", \{\
          type: "violation",\
          npcId: this.npc.id,\
          violations\
        \});\
\
        new DialogueBubble(this.scene, this.npc.base, [\
          "Violation detected.",\
          "Please comply."\
        ], 2000);\
\
        this.stats.modifyStress(10);\
      \}\
    \}\
  \}\
\}\
