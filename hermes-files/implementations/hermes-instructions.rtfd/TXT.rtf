\f4\fs26 \cf0 export class CollaborationManager \{\
  constructor(scene, stats) \{\
    this.scene = scene;\
    this.stats = stats;\
    this.activeAgreements = [];\
  \}\
\
  open(agreement) \{\
    const panel = this.scene.add.rectangle(70, 40, 230, 130, 0x000000, 0.7).setOrigin(0);\
    const text = this.scene.add.text(80, 50, agreement.title, \{ fontSize: "10px", color: "#fff" \});\
\
    const termsText = this.scene.add.text(80, 65, "- " + agreement.terms.join("\\n- "), \{\
      fontSize: "8px",\
      color: "#fff",\
      wordWrap: \{ width: 210 \}\
    \});\
\
    const accept = this.scene.add.text(80, 110, "[Accept Agreement]", \{ fontSize: "8px", color: "#0f0" \})\
      .setInteractive()\
      .on("pointerdown", () => \{\
        this.activeAgreements.push(agreement.id);\
        this.scene.events.emit("world_event", \{ type: "collab_accepted", agreementId: agreement.id \});\
        panel.destroy(); text.destroy(); termsText.destroy(); accept.destroy();\
      \});\
\
    this.panel = panel;\
    this.text = text;\
    this.termsText = termsText;\
    this.accept = accept;\
  \}\
\
  complete(agreementId) \{\
    if (!this.activeAgreements.includes(agreementId)) return;\
    this.activeAgreements = this.activeAgreements.filter(id => id !== agreementId);\
\
    const agreement = this.scene.cache.json.get("collab_templates").agreements\
      .find(a => a.id === agreementId);\
\
    if (agreement) \{\
      this.stats.addXP(agreement.reward_xp);\
      this.scene.events.emit("world_event", \{ type: "collab_completed", agreementId, reward_xp: agreement.reward_xp \});\
    \}\
  \}\
\}\
