\f4\fs26 \cf0 export const EnforcementRules = \{\
  stressLimit: 90,\
  forbiddenZones: ["jail_cell"],\
  suspiciousItems: ["stolen_item"],\
\
  check(player, zone, inventory) \{\
    const violations = [];\
\
    if (player.stress > this.stressLimit) \{\
      violations.push("High stress detected");\
    \}\
\
    if (this.forbiddenZones.includes(zone)) \{\
      violations.push("Unauthorized access to restricted area");\
    \}\
\
    inventory.items.forEach(i => \{\
      if (this.suspiciousItems.includes(i.id)) \{\
        violations.push("Possession of restricted item");\
      \}\
    \});\
\
    return violations;\
  \}\
\};\
