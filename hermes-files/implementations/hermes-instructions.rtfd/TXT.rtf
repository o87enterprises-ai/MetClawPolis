\f3\b\fs36 \cf0 Inventory class\
\pard\pardeftab720\partightenfactor0

\f1\b0\fs24 \cf0 js\
\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 class Inventory \{\
  constructor(scene, config) \{\
    this.scene = scene;\
    this.config = config;\
    this.items = [];\
  \}\
\
  add(id, qty = 1) \{\
    const def = this.config.items.find(i => i.id === id);\
    const existing = this.items.find(i => i.id === id);\
\
    if (existing && def.stackable) \{\
      existing.qty += qty;\
    \} else \{\
      this.items.push(\{ id, qty \});\
    \}\
\
    this.scene.events.emit('world_event', \{\
      type: 'inventory_add',\
      itemId: id,\
      qty\
    \});\
  \}\
\
  remove(id, qty = 1) \{\
    const item = this.items.find(i => i.id === id);\
    if (!item) return;\
\
    item.qty -= qty;\
    if (item.qty <= 0) this.items = this.items.filter(i => i.id !== id);\
  \}\
\}\
\pard\pardeftab720\sa298\partightenfactor0

