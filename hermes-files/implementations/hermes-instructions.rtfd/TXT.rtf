\f4\fs26 \cf0 export class MiniMap \{\
  constructor(scene, world, player, npcs) \{\
    this.scene = scene;\
    this.world = world;\
    this.player = player;\
    this.npcs = npcs;\
\
    this.scale = 0.2;\
    this.size = 128;\
\
    this.bg = scene.add.rectangle(\
      scene.scale.width - this.size - 10,\
      scene.scale.height - this.size - 10,\
      this.size, this.size,\
      0x000000, 0.6\
    ).setOrigin(0);\
\
    this.graphics = scene.add.graphics().setScrollFactor(0);\
    this.bg.setScrollFactor(0);\
\
    this.bg.setInteractive().on('pointerdown', (p) => \{\
      const localX = p.x - this.bg.x;\
      const localY = p.y - this.bg.y;\
      const worldX = localX / this.scale;\
      const worldY = localY / this.scale;\
      scene.cameras.main.pan(worldX, worldY, 300, 'Sine.easeInOut');\
    \});\
  \}\
\
  update() \{\
    this.graphics.clear();\
\
    // Draw player\
    this.graphics.fillStyle(0x00ff00);\
    this.graphics.fillCircle(\
      this.bg.x + this.player.x * this.scale,\
      this.bg.y + this.player.y * this.scale,\
      2\
    );\
\
    // Draw NPCs\
    this.graphics.fillStyle(0xff0000);\
    Object.values(this.npcs).forEach(npc => \{\
      this.graphics.fillCircle(\
        this.bg.x + npc.base.x * this.scale,\
        this.bg.y + npc.base.y * this.scale,\
        2\
      );\
    \});\
  \}\
\}\
