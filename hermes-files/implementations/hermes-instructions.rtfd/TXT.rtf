\f4\fs26 \cf0 export class AvatarCreator \{\
  constructor(scene, charConfig) \{\
    this.scene = scene;\
    this.config = charConfig;\
    this.selection = \{\
      base_body: "male",\
      skin_tone: "light_tan",\
      hair_style: "short",\
      hair_color: "brown",\
      outfit: "casual",\
      accessory: "none",\
      expression: "neutral"\
    \};\
  \}\
\
  createUI(x, y) \{\
    const panel = this.scene.add.rectangle(x, y, 180, 200, 0x000000, 0.7).setOrigin(0);\
    const preview = this.scene.add.container(x + 90, y + 40);\
\
    const updatePreview = () => \{\
      preview.removeAll(true);\
      const layers = this.buildLayers(0, 0);\
      layers.forEach(l => preview.add(l));\
    \};\
\
    const makeButton = (label, key, options, offsetY) => \{\
      const text = this.scene.add.text(x + 10, y + offsetY, label, \{ fontSize: '8px', color: '#fff' \});\
      const btn = this.scene.add.text(x + 80, y + offsetY, "<>", \{ fontSize: '8px', color: '#0ff' \})\
        .setInteractive()\
        .on('pointerdown', () => \{\
          const list = this.config[key];\
          const idx = list.findIndex(o => o.id === this.selection[key]);\
          const next = list[(idx + 1) % list.length];\
          this.selection[key] = next.id;\
          updatePreview();\
        \});\
      return [text, btn];\
    \};\
\
    makeButton("Body", "base_bodies", this.config.base_bodies, 80);\
    makeButton("Skin", "skin_tones", this.config.skin_tones, 95);\
    makeButton("Hair", "hair_styles", this.config.hair_styles, 110);\
    makeButton("Color", "hair_colors", this.config.hair_colors, 125);\
    makeButton("Outfit", "outfits", this.config.outfits, 140);\
    makeButton("Accessory", "accessories", this.config.accessories, 155);\
\
    updatePreview();\
    return \{ panel, preview \};\
  \}\
\
  buildLayers(x, y) \{\
    const layers = [];\
    const add = (frame, tint) => \{\
      if (frame === null) return;\
      const s = this.scene.add.sprite(x, y, 'chars', frame).setOrigin(0.5);\
      if (tint) s.setTint(tint);\
      layers.push(s);\
    \};\
\
    const sel = this.selection;\
    const cfg = this.config;\
\
    add(cfg.base_bodies.find(b => b.id === sel.base_body).frame);\
    add(null, cfg.skin_tones.find(s => s.id === sel.skin_tone).hex);\
    add(cfg.hair_styles.find(h => h.id === sel.hair_style).frame,\
        cfg.hair_colors.find(c => c.id === sel.hair_color).tint);\
    add(cfg.outfits.find(o => o.id === sel.outfit).frame);\
    add(cfg.accessories.find(a => a.id === sel.accessory).frame);\
    add(cfg.expressions.find(e => e.id === sel.expression).frame_offset);\
\
    return layers;\
  \}\
\}\
