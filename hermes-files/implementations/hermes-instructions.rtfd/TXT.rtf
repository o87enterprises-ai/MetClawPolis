\f4\fs26 \cf0 function createLiveStreamPanel(scene) \{\
  const panel = scene.add.rectangle(scene.scale.width - 160, 8, 152, 100, 0x000000, 0.6).setOrigin(0, 0);\
  const text = scene.add.text(scene.scale.width - 156, 12, 'Live Feed:\\n', \{\
    fontSize: '8px',\
    color: '#ffffff',\
    wordWrap: \{ width: 144 \}\
  \});\
\
  panel.setScrollFactor(0);\
  text.setScrollFactor(0);\
\
  const lines = [];\
\
  const pushEvent = (msg) => \{\
    lines.push(msg);\
    if (lines.length > 6) lines.shift();\
    text.setText('Live Feed:\\n' + lines.join('\\n'));\
  \};\
\
  return \{ panel, text, pushEvent \};\
\}\
