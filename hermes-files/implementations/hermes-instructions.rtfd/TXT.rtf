export function create() \{\
  const world = this.cache.json.get('bitsburg_world');\
  const charsConfig = this.cache.json.get('bitsburg_chars');\
\
  // Simple ground layer from procedural rows\
  const tileSize = world.tile_size[0];\
  const map = this.make.tilemap(\{\
    tileWidth: tileSize,\
    tileHeight: tileSize,\
    width: world.size[0],\
    height: world.size[1]\
  \});\
\
  const groundTiles = map.addTilesetImage('ground');\
  const groundLayer = map.createBlankLayer('Ground', groundTiles);\
\
  world.map_grid_procedural.rows.forEach((row, y) => \{\
    row.split('').forEach((ch, x) => \{\
      // very simple mapping; you can expand this\
      let index = 0;\
      if (ch === 'G') index = 1;\
      if (ch === 'R') index = 2;\
      if (ch === 'W') index = 3;\
      if (ch === 'P') index = 4;\
      groundLayer.putTileAt(index, x, y);\
    \});\
  \});\
\
  // NPC creation helper\
  const npcSprites = \{\};\
  world.npcs.forEach(npc => \{\
    const preset = charsConfig.npc_presets.find(p => p.id === npc.id) || charsConfig.npc_presets[0];\
    const pos = npc.location_coords || [\
      (world.zones\
        .flatMap(z => z.buildings)\
        .find(b => b.id === npc.location_building).coords[0]) * tileSize,\
      (world.zones\
        .flatMap(z => z.buildings)\
        .find(b => b.id === npc.location_building).coords[1]) * tileSize\
    ];\
\
    const sprite = this.add.sprite(pos[0], pos[1], 'chars', 0);\
    sprite.setOrigin(0, 0);\
\
    // TODO: apply layers/tints based on preset (base, hair, outfit, etc.)\
    sprite.setData('npcId', npc.id);\
    sprite.setInteractive();\
\
    sprite.on('pointerdown', () => \{\
      const line = Phaser.Utils.Array.GetRandom(npc.dialogue);\
      console.log(`$\{npc.name\}: $\{line\}`);\
      // hook into your UI dialogue system here\
    \});\
\
    npcSprites[npc.id] = sprite;\
  \});\
\
  this.cameras.main.setBounds(0, 0, world.size[0] * tileSize, world.size[1] * tileSize);\
\}\
