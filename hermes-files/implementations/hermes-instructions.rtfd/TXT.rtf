\f4\fs26 \cf0 export class CharacterFactory \{\
  constructor(scene, config) \{\
    this.scene = scene;\
    this.config = config;\
    this.sheet = 'chars';\
  \}\
\
  create(x, y, preset) \{\
    const base = this.scene.add.sprite(x, y, this.sheet, preset.base_frame);\
    base.setOrigin(0.5);\
\
    const layers = [];\
\
    const addLayer = (frame, tint) => \{\
      if (frame === null) return;\
      const s = this.scene.add.sprite(x, y, this.sheet, frame);\
      s.setOrigin(0.5);\
      if (tint) s.setTint(tint);\
      layers.push(s);\
    \};\
\
    addLayer(preset.skin_frame, preset.skin_tint);\
    addLayer(preset.hair_frame, preset.hair_tint);\
    addLayer(preset.outfit_frame);\
    addLayer(preset.accessory_frame);\
    addLayer(preset.expression_frame);\
\
    return \{ base, layers \};\
  \}\
\
  applyAnimation(sprite, animKey) \{\
    sprite.base.play(animKey);\
    sprite.layers.forEach(l => l.play(animKey));\
  \}\
\}\
