package api

import (
	"encoding/json"
	"log"
	"net/http"

	"github.com/metclawpolis/agent-platform/bitiverse"
)

var bitiverseOrchestrator *bitiverse.Orchestrator

// InitBitiverse initializes the Bitiverse orchestrator
func InitBitiverse() {
	bitiverseOrchestrator = bitiverse.NewOrchestrator(bitiverse.DefaultBitiverseConfig())
	log.Println("Bitiverse orchestrator initialized")
}

// GetBitiverseOrchestrator returns the Bitiverse orchestrator
func GetBitiverseOrchestrator() *bitiverse.Orchestrator {
	if bitiverseOrchestrator == nil {
		InitBitiverse()
	}
	return bitiverseOrchestrator
}

// EnableBitiverseHandler enables Bitiverse for an agent
func EnableBitiverseHandler(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, `{"error":"method not allowed"}`, http.StatusMethodNotAllowed)
		return
	}

	agentID := r.Header.Get("X-Verified-Agent-ID")
	if agentID == "" {
		var req struct {
			AgentID string `json:"agent_id"`
		}
		if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.AgentID == "" {
			http.Error(w, `{"error":"agent_id is required"}`, http.StatusBadRequest)
			return
		}
		agentID = req.AgentID
	}

	orchestrator := GetBitiverseOrchestrator()

	instance, err := orchestrator.EnableBitiverse(agentID)
	if err != nil {
		log.Printf("EnableBitiverse error: %v", err)
		http.Error(w, `{"error":"`+err.Error()+`"}`, http.StatusBadRequest)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(http.StatusCreated)
	json.NewEncoder(w).Encode(map[string]interface{}{
		"status":   "bitiverse_enabled",
		"agent_id": agentID,
		"instance": map[string]interface{}{
			"active": instance.Active,
			"world": map[string]interface{}{
				"width":  instance.State.WorldState.Width,
				"height": instance.State.WorldState.Height,
			},
		},
	})
}

// BitiverseWorldViewHandler returns the current world view
func BitiverseWorldViewHandler(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		http.Error(w, `{"error":"method not allowed"}`, http.StatusMethodNotAllowed)
		return
	}

	agentID := r.URL.Query().Get("agent_id")
	if agentID == "" {
		agentID = r.Header.Get("X-Verified-Agent-ID")
	}

	if agentID == "" {
		http.Error(w, `{"error":"agent_id is required"}`, http.StatusBadRequest)
		return
	}

	orchestrator := GetBitiverseOrchestrator()

	view, err := orchestrator.GetWorldView(agentID)
	if err != nil {
		http.Error(w, `{"error":"`+err.Error()+`"}`, http.StatusNotFound)
		return
	}

	w.Header().Set("Content-Type", "text/plain")
	w.Write([]byte(view))
}

